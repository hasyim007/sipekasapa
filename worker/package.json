{
  "name": "sipekasapa-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend SIPEKA SAPA (Sistem Pengaduan & Konsultasi SDN 01 Papahan) — Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute sipekasapa-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute sipekasapa-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
